# Job histórico. No Pi o fragmento activo é taskhive.scrape.yml.template.
global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: taskhive-api
    metrics_path: /metrics
    authorization:
      type: Bearer
      credentials: ${METRICS_TOKEN}
    static_configs:
      - targets:
          - task-hive-api:3001
        labels:
          service: taskhive-api
